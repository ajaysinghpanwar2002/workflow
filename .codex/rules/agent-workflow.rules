# Codex execpolicy rules for the implementer + reviewer workflow.
#
# scripts/codex-review.sh spawns a separate `codex exec review` reviewer
# process, which needs network access and therefore cannot run inside the
# implementer's sandbox. `decision = "allow"` runs the matched command outside
# the sandbox without prompting. The exposure is narrow: only this one script is
# allowed, and the reviewer it launches runs with `--sandbox read-only` in this
# repository, so it can read the code under review but not modify it.
#
# Note: project-level rules under .codex/rules/ load only when the project's
# .codex/ layer is trusted by the local Codex CLI.

prefix_rule(
    pattern = [["scripts/codex-review.sh", "./scripts/codex-review.sh"]],
    decision = "allow",
    justification = "Launches the separate read-only Codex reviewer; needs network, so it must run outside the sandbox",
    match = [
        "scripts/codex-review.sh",
        "./scripts/codex-review.sh",
    ],
    not_match = [
        "scripts/install-agent-workflow.sh",
    ],
)

prefix_rule(
    pattern = [["bash", "sh"], ["scripts/codex-review.sh", "./scripts/codex-review.sh"]],
    decision = "allow",
    justification = "Launches the separate read-only Codex reviewer via a shell; needs network, so it must run outside the sandbox",
    match = [
        "bash scripts/codex-review.sh",
        "sh ./scripts/codex-review.sh",
    ],
    not_match = [
        "bash scripts/other.sh",
        "bash -c scripts/codex-review.sh",
    ],
)
